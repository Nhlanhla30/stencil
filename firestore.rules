rules_version = '2';

// Deny all client access. Stencil touches Firestore only through the Firebase
// Admin SDK (server-side), which bypasses these rules entirely — so the app
// keeps working while the client SDK is locked out completely. Client deposits
// and booking details must never be readable or writable from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
